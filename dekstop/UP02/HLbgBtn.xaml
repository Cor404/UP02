<UserControl x:Class="UP02.HLbgBtn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UP02"
             mc:Ignorable="d" 
             d:DesignHeight="29" d:DesignWidth="60">
    <Grid>
        <Border Background="{StaticResource hl_win1}"/>
        <Border BorderThickness="1,1,0,0" BorderBrush="{StaticResource hl_win2}"></Border>
        <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource hl_win3}"></Border>
        <TextBlock Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12" FontFamily="Trebuchet MS" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Aliased" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,10,10,10" Foreground="White"/>
    </Grid>
</UserControl>
