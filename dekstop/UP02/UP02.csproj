<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="dinpro.otf" />
    <None Remove="dinpro_bold.otf" />
    <None Remove="sounds\buttonclick.wav" />
    <None Remove="sounds\buttonclickrelease.wav" />
    <None Remove="sounds\buttonrollover.wav" />
    <None Remove="sprites\bg.png" />
    <None Remove="sprites\logo.png" />
    <None Remove="trebuchetms.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="dinpro.otf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="dinpro_bold.otf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Content Include="sounds\buttonclick.wav">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="sounds\buttonclickrelease.wav">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="sounds\buttonrollover.wav">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Resource Include="sprites\bg.png" />
    <Resource Include="sprites\logo.png" />
    <Resource Include="trebuchetms.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

</Project>
