<Window x:Class="UP02.Users"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP02"
        xmlns:tmp="clr-namespace:UP02.Templates"
        mc:Ignorable="d"
        Style="{DynamicResource HLWin}"
        Title="Пользователи" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <local:HLBorder Margin="0,0,0,30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="0.2*"/>
                </Grid.RowDefinitions>

                <ListView Style="{StaticResource HLlv}" Margin="10,20,10,20">
                    <ListViewItem Style="{StaticResource HLlvi}">
                        <Image Source="/sprites/logo.png" Width="100"/>
                    </ListViewItem>
                    <ListViewItem Style="{StaticResource HLlvi}">
                        <Image Source="/sprites/logo.png" Width="100"/>
                    </ListViewItem>
                    <ListViewItem Style="{StaticResource HLlvi}">
                        <Image Source="/sprites/logo.png" Width="100"/>
                    </ListViewItem>
                    <ListViewItem Style="{StaticResource HLlvi}">
                        <Image Source="/sprites/logo.png" Width="100"/>
                    </ListViewItem>
                    <ListViewItem Style="{StaticResource HLlvi}">
                        <Image Source="/sprites/logo.png" Width="100"/>
                    </ListViewItem>
                    <ListViewItem Style="{StaticResource HLlvi}">
                        <Image Source="/sprites/logo.png" Width="100"/>
                    </ListViewItem>
                </ListView>

                <Separator HorizontalAlignment="Stretch" Grid.Row="1" Height="1" Background="{StaticResource hl_win4}" Margin="8,0,8,0"/>

                <local:HLbgBtn Text="Добавить" Grid.Column="0" Grid.Row="2" Margin="10"/>
            </Grid>
        </local:HLBorder>
    </Grid>
</Window>
