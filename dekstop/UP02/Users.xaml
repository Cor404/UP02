<Window x:Class="UP02.Users"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP02"
        xmlns:tmp="clr-namespace:UP02.Templates"
        mc:Ignorable="d"
        Style="{DynamicResource HLWin}"
        Title="Пользователи" Height="450" Width="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="0.45*"/>
        </Grid.ColumnDefinitions>

            <ListView Style="{StaticResource HLlv}" Margin="10,20,10,20">
                </ListView>

        <Border Width="1" Grid.Column="1" VerticalAlignment="Stretch" Background="{StaticResource hl_win4}" Margin="0,2,0,2"/>

        <Grid Grid.Column="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <local:HLbgBtn Text="Добавить" Grid.Column="0" Grid.Row="0" Width="70" Margin="4"/>
            <local:HLbgBtn Text="Изменить" Grid.Column="1" Grid.Row="0" Width="70" Margin="4"/>
            <local:HLbgBtn Text="Удалить" Grid.Column="2" Grid.Row="2" Width="70" Margin="4"/>
        </Grid>
        

    </Grid>
</Window>
