<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <!-- Задний фон (трек) -->
                        <Border Name="PART_Track">
                            <Grid>
                                <Border x:Name="brd1" Background="{StaticResource hl_win4}"/>
                                <Border x:Name="brd2" BorderBrush="{StaticResource hl_win2}" BorderThickness="0,0,0.5,0.5"/>
                                <Border x:Name="brd3" BorderBrush="{StaticResource hl_win3}" BorderThickness="0.5,0.5,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Заполняемая полоса (обязательно имя PART_Indicator) -->
                        <Border Name="PART_Indicator" 
                        Background="{StaticResource hl_win_text_sel}" 
                        HorizontalAlignment="Left"
                                Margin="4"/>

                        <!-- Текст по центру -->
                        <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, StringFormat={}{0:0}%}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource hl_win2}"
                                   Background="{StaticResource hl_win4}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>