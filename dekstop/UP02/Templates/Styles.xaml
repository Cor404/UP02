<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Trebuchet MS"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="HLlvi" TargetType="{x:Type ListViewItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Grid x:Name="grid" HorizontalAlignment="Stretch">
                        <Border x:Name="brd1" Background="{StaticResource hl_win1}"/>
                        <Border x:Name="brd2" BorderBrush="{StaticResource hl_win2}" BorderThickness="0.5,0.5,0,0"/>
                        <Border x:Name="brd3" BorderBrush="{StaticResource hl_win3}" BorderThickness="0,0,0.5,0.5"/>
                        <ContentPresenter x:Name="cn" Margin="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" TargetName="brd1" Value="{StaticResource hl_win2}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <Style x:Key="HLsb" TargetType="{x:Type ScrollBar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="Bg" Background="{StaticResource hl_win4}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb >
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Border Background="{StaticResource hl_win1}"/>
                                                <Border BorderBrush="{StaticResource hl_win2}" BorderThickness="0.5,0.5,0,0"/>
                                                <Border BorderBrush="{StaticResource hl_win3}" BorderThickness="0,0,0.5,0.5"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="sbThumb" TargetType="{x:Type Thumb}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Focusable" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Width="{TemplateBinding Width}">
                        <Border Background="{StaticResource hl_win1}"/>
                        <Border BorderBrush="{StaticResource hl_win2}" BorderThickness="0.5,0.5,0,0"/>
                        <Border BorderBrush="{StaticResource hl_win3}" BorderThickness="0,0,0.5,0.5"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="sbVert" TargetType="{x:Type ScrollBar}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Focusable" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Track x:Name="PART_Track" Width="20" IsDirectionReversed="True" Margin="0,1,2,1">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ResourceKey=sbThumb}" Width="20"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HLlv" TargetType="{x:Type ListView}">
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListView}">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="20"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource hl_win4}" Grid.ColumnSpan="2"/>
                        <Border BorderBrush="{StaticResource hl_win2}" BorderThickness="0,0,0.5,0.5" Grid.ColumnSpan="2"/>
                        <Border BorderBrush="{StaticResource hl_win3}" BorderThickness="0.5,0.5,0,0" Grid.ColumnSpan="2"/>
                        <ScrollViewer Focusable="True" Grid.ColumnSpan="2" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollViewer}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ScrollViewer}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="20"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ScrollContentPresenter Margin="1,1,0,1" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                    <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource sbVert}" Orientation="Vertical"
                                                               Value="{TemplateBinding VerticalOffset}"
                                                               Maximum="{TemplateBinding ScrollableHeight}"
                                                               ViewportSize="{TemplateBinding ViewportHeight}"
                                                               Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                                               Width="20"
                                                               />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ScrollViewer.Resources>
                            <ItemsPresenter Margin="1"/>
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>