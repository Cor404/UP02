<UserControl x:Class="UP02.Templates.HLlv"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UP02.Templates"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="130">
    <Grid>
        
        <ListView Background="{StaticResource hl_win4}" Margin="1" BorderThickness="0" ScrollViewer.CanContentScroll="False" ScrollViewer.VerticalScrollBarVisibility="Visible" HorizontalContentAlignment="Stretch">
            <ListView.Resources>
                <Style TargetType="ScrollBar">
                    <!-- Пример: задаем ширину вертикального ползунка -->
                    <Setter Property="Width" Value="4"/>
                    <!-- Пример: задаем цвет фона бегунка -->
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid x:Name="Bg" Background="{StaticResource hl_win4}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Grid>
                                                            <Border Background="{StaticResource hl_win1}"/>
                                                            <Border BorderBrush="{StaticResource hl_win2}" BorderThickness="1,1,0,0"/>
                                                            <Border BorderBrush="{StaticResource hl_win3}" BorderThickness="0,0,1,1"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.Resources>
            <local:HLlvi Height="20"/>
        </ListView>
        <Border BorderBrush="{StaticResource hl_win2}" BorderThickness="0,0,1,1"/>
        <Border BorderBrush="{StaticResource hl_win3}" BorderThickness="1,1,0,0"/>
    </Grid>
</UserControl>
