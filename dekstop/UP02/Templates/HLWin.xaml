<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="UP02.Templates.HLWin"
                    xmlns:local="clr-namespace:UP02"
                    >
    <Style x:Key="HLWin" TargetType="{x:Type Window}">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Window}">
                    
                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="200"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Border Background="{StaticResource hl_win1}" Grid.RowSpan="2"/>
                        <Border BorderThickness="1,1,0,0" BorderBrush="{StaticResource hl_win2}" Grid.RowSpan="2"></Border>
                        <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource hl_win3}" Grid.RowSpan="2"></Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <local:HLbgBtn Text="X" Width="80" Height="80"/>

                        </Grid>
                        
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>