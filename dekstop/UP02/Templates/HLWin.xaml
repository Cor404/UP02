<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="UP02.Templates.HLWin"
                    xmlns:local="clr-namespace:UP02"
                    >
    <Style x:Key="HLWin" TargetType="{x:Type Window}">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="32" 
                      GlassFrameThickness="0" 
                      CornerRadius="0"
                      ResizeBorderThickness="4"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Window}">
                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Border Background="{StaticResource hl_win1}" Grid.RowSpan="2"/>
                        <Border BorderThickness="1,1,0,0" BorderBrush="{StaticResource hl_win2}" Grid.RowSpan="2"></Border>
                        <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource hl_win3}" Grid.RowSpan="2"></Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="/sprites/logo.png" Margin="4" Width="22" Height="22"/>
                            <TextBlock Text="{TemplateBinding Title}" Margin="4,8,6,6" Grid.Column="1" Foreground="White" TextOptions.TextRenderingMode="Aliased" TextOptions.TextFormattingMode="Display"/>
                            <local:HLbgBtn x:Name="btnFullWindow" Text="□" Width="22" Height="22" Grid.Column="2" Margin="4" FontSize="16" WindowChrome.IsHitTestVisibleInChrome="True"/>
                            <local:HLbgBtn x:Name="btnMinWindow" Text="_" Width="22" Height="22" Grid.Column="3" Margin="4" FontSize="16" WindowChrome.IsHitTestVisibleInChrome="True"/>
                            <local:HLbgBtn x:Name="btnCloseWindow" Text="✕" Width="22" Height="22" Grid.Column="4" Margin="4" FontSize="12" WindowChrome.IsHitTestVisibleInChrome="True"/>

                        </Grid>

                        <ContentPresenter Grid.Row="1"/>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="HLWin_X" TargetType="{x:Type Window}">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="32" 
                      GlassFrameThickness="0" 
                      CornerRadius="0"
                      ResizeBorderThickness="4"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Window}">
                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Border Background="{StaticResource hl_win1}" Grid.RowSpan="2"/>
                        <Border BorderThickness="1,1,0,0" BorderBrush="{StaticResource hl_win2}" Grid.RowSpan="2"></Border>
                        <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource hl_win3}" Grid.RowSpan="2"></Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <local:HLbgBtn x:Name="btnCloseWindow" Text="✕" Width="22" Height="22" Grid.Column="1" Margin="4" FontSize="12" WindowChrome.IsHitTestVisibleInChrome="True"/>

                        </Grid>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    
</ResourceDictionary>