<UserControl x:Class="UP02.HLBorder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UP02"
             mc:Ignorable="d" 
             d:DesignHeight="20" d:DesignWidth="100">
    <Grid>
        <Border Background="{StaticResource hl_win1}"/>
        <Border BorderThickness="1,1,0,0" BorderBrush="{StaticResource hl_win2}"></Border>
        <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource hl_win3}"></Border>
        <ContentPresenter>
            
        </ContentPresenter>
    </Grid>
</UserControl>
