<UserControl x:Class="UP02.HLnobgbtn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UP02"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="50">
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border x:Name="btnBg" MouseEnter="Border_MouseEnter" MouseLeave="Border_MouseLeave" MouseLeftButtonDown="btnBg_MouseLeftButtonDown" MouseLeftButtonUp="btnBg_MouseLeftButtonUp">
            <TextBlock x:Name="btnTbl" Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource hl_orange}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.6" FontFamily="Trebuchet MS" FontWeight="Bold" Margin="4">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="20" Color="#FBA314" ShadowDepth="0" Opacity="0.9"/>
                </TextBlock.Effect>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
