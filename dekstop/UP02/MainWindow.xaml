<Window x:Class="UP02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP02"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <local:cborder Width="400" Height="200"></local:cborder>
        <Canvas>
            <StackPanel Canvas.Right="10" Canvas.Bottom="10" Orientation="Horizontal">
                <TextBlock x:Name="t1" Text="x:1"/>
                <TextBlock x:Name="t2" Text="y:1"/>
            </StackPanel>
        </Canvas>
    </Grid>
</Window>
