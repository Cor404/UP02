<Window x:Class="UP02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP02"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="auto"
        Width="auto"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        >
    <Grid>
        <Image Source="/sprites/bg.png"/>
        <Grid>
        <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.25*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="0.4*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="P R O - P L I T  &amp;  C o" Foreground="#fb7e14" FontWeight="Bold" FontSize="50" Opacity="0.6" Margin="20,160,20,0" TextOptions.TextRenderingMode="Aliased" TextOptions.TextFormattingMode="Display" Grid.ColumnSpan="2">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="8" Color="#fb7e14" Opacity="0.8" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>
                <TextBlock Text="P L I T K A - S E R V I C E" Foreground="#B5590E" FontWeight="Bold" FontSize="20" Opacity="0.6" Margin="20,0,0,0" Grid.Row="1" Grid.ColumnSpan="2">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="8" Color="#B5590E" Opacity="0.8" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>

                <local:HLnobgbtn Text="Заказы" FontSize="20" Grid.Row="3" Margin="20,10,0,0"/>
                <local:HLnobgbtn Text="Курьеры" FontSize="20" Grid.Row="4" Margin="20,10,0,0"/>
                <local:HLnobgbtn Text="Платежи" FontSize="20" Grid.Row="5" Margin="20,10,0,0"/>
                <local:HLnobgbtn Text="Заявки" FontSize="20" Grid.Row="6" Margin="20,10,0,0"/>
                <local:HLnobgbtn Text="Выход" FontSize="20" Grid.Row="7" Margin="20,10,0,0"/>

            </Grid>
        </Grid>
    </Grid>
</Window>
