<Window x:Class="UP02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP02"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="896"
        Width="1195"
        MinHeight="896"
        MinWidth="1195"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        >
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" 
      GlassFrameThickness="5" 
      CornerRadius="0"
      ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>
    <Grid Background="Black">
        <!--<Image Source="/sprites/bg.png" Stretch="Fill"/>-->
        <Grid>
        <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

            <Grid Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <local:HLnobgbtn x:Name="winBtnMaximize" Grid.Column="1" Text="[]" Margin="2" FontSize="14" WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonUp="winBtnMaximize_MouseLeftButtonUp"/>
                <local:HLnobgbtn x:Name="winBtnMinimize" Grid.Column="2" Text="__" Margin="2" FontSize="14" WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonUp="HLnobgbtn_MouseLeftButtonUp_1"/>
                <local:HLnobgbtn x:Name="winBtnClose" Grid.Column="3" Text="✕" Margin="2" FontSize="14" WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonUp="HLnobgbtn_MouseLeftButtonUp"/>
            </Grid>
            
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="0.3*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="P R O - P L I T  &amp;  C o ™" Foreground="#fb7e14" FontWeight="Bold" FontSize="50" Opacity="0.6" Margin="20,160,20,0" TextOptions.TextRenderingMode="Aliased" TextOptions.TextFormattingMode="Display" Grid.ColumnSpan="2">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="8" Color="#fb7e14" Opacity="0.8" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>
                <TextBlock Text="P L I T K A - S E R V I C E" Foreground="#B5590E" FontWeight="Bold" FontSize="18" Opacity="0.6" Margin="20,0,0,0" Grid.Row="1" Grid.ColumnSpan="2" TextOptions.TextRenderingMode="Aliased" TextOptions.TextFormattingMode="Display">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="8" Color="#B5590E" Opacity="0.8" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>
                <TextBlock Text="All rights reserved©" Foreground="#B5590E" FontSize="14" Opacity="0.6" Margin="10" Grid.Row="10" Grid.ColumnSpan="2" TextOptions.TextRenderingMode="Aliased" TextOptions.TextFormattingMode="Display">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="8" Color="#B5590E" Opacity="0.8" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>

                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    
                    <local:HLnobgbtn Text="Производство" FontSize="18" Grid.Row="0" Margin="20,10,0,0"/>
                    <local:HLnobgbtn Text="Склад" FontSize="18" Grid.Row="1" Margin="20,10,0,0"/>
                    <local:HLnobgbtn Text="Продажи" FontSize="18" Grid.Row="2" Margin="20,10,0,0"/>
                    <local:HLnobgbtn Text="Пользователи" FontSize="18" Grid.Row="3" Margin="20,10,0,0" MouseLeftButtonUp="HLnobgbtn_MouseLeftButtonUp_2"/>
                    <local:HLnobgbtn MouseDown="HLnobgbtn_Exit_MouseDown" Text="Выход" FontSize="20" Grid.Row="4" Margin="20,10,0,0"/>

                    <TextBlock Text="Меню и отчеты производства" Grid.Column="1" Grid.Row="0" Margin="20,10,0,0" FontFamily="Trebuchet MS" TextOptions.TextRenderingMode="Aliased" TextOptions.TextFormattingMode="Display" Foreground="{StaticResource hl_win2}"/>
                    <TextBlock Text="Количество и закупка материалов на склад" Grid.Column="1" Grid.Row="1" Margin="20,10,0,0" FontFamily="Trebuchet MS" TextOptions.TextRenderingMode="Aliased" TextOptions.TextFormattingMode="Display" Foreground="{StaticResource hl_win2}"/>
                    <TextBlock Text="Продажи продукции и отчетность" Grid.Column="1" Grid.Row="2" Margin="20,10,0,0" FontFamily="Trebuchet MS" TextOptions.TextRenderingMode="Aliased" TextOptions.TextFormattingMode="Display" Foreground="{StaticResource hl_win2}"/>
                    <TextBlock Text="Список пользователей(только для администраторов)" Grid.Column="1" Margin="20,10,0,0" Grid.Row="3" FontFamily="Trebuchet MS" TextOptions.TextRenderingMode="Aliased" TextOptions.TextFormattingMode="Display" Foreground="{StaticResource hl_win2}"/>
                    <TextBlock Text="...наверное..." Grid.Column="1" Grid.Row="4" Margin="20,10,0,0" FontFamily="Trebuchet MS" TextOptions.TextRenderingMode="Aliased" TextOptions.TextFormattingMode="Display" Foreground="{StaticResource hl_win2}"/>
                    
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
