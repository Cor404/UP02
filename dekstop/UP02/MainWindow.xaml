<Window x:Class="UP02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP02"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        >
    <Grid Background="DarkSlateGray">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="0.4*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="F λ S T - L I F E" Foreground="#fb7e14" FontWeight="Bold" FontSize="30" Opacity="0.6" Margin="20,40,20,0" TextOptions.TextRenderingMode="Aliased" TextOptions.TextFormattingMode="Display">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="8" Color="#fb7e14" Opacity="0.8" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="D E L I V E R Y - S E R V I C E" Foreground="#B5590E" FontWeight="Bold" FontSize="10" Opacity="0.6" Margin="20,0,0,0" Grid.Row="1">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="8" Color="#B5590E" Opacity="0.8" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>

            <local:HLnobgbtn Text="Заказы" Grid.Row="3" Margin="20,0,0,0"/>
            <local:HLnobgbtn Text="Курьеры" Grid.Row="4" Margin="20,0,0,0"/>
            <local:HLnobgbtn Text="Платежи" Grid.Row="5" Margin="20,0,0,0"/>
            <local:HLnobgbtn Text="Заявки" Grid.Row="6" Margin="20,0,0,0"/>

        </Grid>

    </Grid>
</Window>
