<Window x:Class="UP02.HLdialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP02"
        mc:Ignorable="d"
        Title="HLdialog" 
        Height="100" 
        Width="320"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource HLWin_X}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!--<Border HorizontalAlignment="Stretch" Height="1" Background="{StaticResource hl_win4}" Grid.Row="1" Margin="6,0,6,0"/>-->

        <TextBlock x:Name="tblText" Text="Text" Grid.Row="2" Margin="6" TextWrapping="WrapWithOverflow"/>

        <Border HorizontalAlignment="Stretch" Height="1" Background="{StaticResource hl_win4}" Grid.Row="3" Margin="6,0,6,0"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <local:HLbgBtn x:Name="btnYes" Text="Да" Width="60" Grid.Column="1" Margin="6" MouseLeftButtonUp="btnYes_MouseLeftButtonUp"/>
            <local:HLbgBtn x:Name="btnNo" Text="Нет" Width="60" Grid.Column="2" Margin="6" MouseLeftButtonUp="btnNo_MouseLeftButtonUp"/>
            <local:HLbgBtn x:Name="btnOK" Text="Ок" Width="60" Grid.Column="2" Margin="6" MouseLeftButtonUp="btnOK_MouseLeftButtonUp"/>
        </Grid>
    </Grid>
</Window>
